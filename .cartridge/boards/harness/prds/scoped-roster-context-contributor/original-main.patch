+/// Summary maintenance must not abort a context that still fits. Only recover
+/// from summarizer failures; storage and transcript errors remain explicit.
+/// Explicit `compact` calls continue to report unsuccessful refreshes.
+async fn refresh_context(
+	host: &Host,
+	config: &Config,
+	request: &Request,
+	saved: Option<&str>,
+) -> Result<Value, String> {
+	let error = match compact(host, config, request).await {
+		Err(error) if error.starts_with("context_over_budget: summary ") => error,
+		result => return result,
+	};
+	// Include messages appended while the provider was answering. Revalidate
+	// the saved prefix against this fresh journal before using its summary.
+	let fresh = read_transcript(host, request.transcript_id).await?;
+	project_messages(&fresh)?;
+	let fallback = match saved.and_then(|saved| working::valid_saved(config, &fresh, saved)) {
+		Some((end, summary)) => working::project(config, request, &fresh, end, &summary),
+		None => build_context(
+			SystemPrompt {
+				base: &config.system,
+				template: &request.template,
+			},
+			request.frame(),
+			&request.instructions,
+			&fresh,
+			&request.descriptors,
+			config.max_bytes.saturating_sub(config.output_headroom),
+		),
+	};
+	match fallback {
+		Err(fallback_error) if fallback_error.starts_with("context_over_budget") => Err(error),
+		result => result,
+	}
+}
