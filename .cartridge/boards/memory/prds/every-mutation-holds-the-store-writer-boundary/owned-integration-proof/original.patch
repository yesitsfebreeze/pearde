+#[test]
+fn graph_export_reads_hot_and_cold_without_modifying_the_database() {
+	use base::base_types::{mk_entity, EntityKind, Memory};
+	let dir = tempfile::tempdir().unwrap();
+	let path = dir.path().to_str().unwrap();
+	let mut hot = mk_entity("hot", &"Full body ".repeat(100), 0.0, EntityKind::Document);
+	hot.vector = vec![0.1, 0.2].into();
+	let mut cold = mk_entity("cold", "Cold body", 0.0, EntityKind::Document);
+	cold.vector = vec![0.3, 0.4].into();
+	{
+		let store = Store::open(path).unwrap();
+		let mut memory = Memory::new("group", "");
+		memory.entities.insert(hot.id.clone(), hot.clone());
+		store.save_one_memory(&memory).unwrap();
+		store.cold_put_all(&[cold.clone()]).unwrap();
+		let closed = store.env.clone().prepare_for_closing();
+		drop(store);
+		closed.wait();
+	}
+	let file = dir.path().join("data.mdb");
+	let before = std::fs::read(&file).unwrap();
+	let graph = read_graph_view(path, false, true, None, None).unwrap();
+	assert_eq!(graph["nodes"].as_array().unwrap().len(), 2);
+	assert_eq!(graph["groups"].as_array().unwrap().len(), 1);
+	assert!(graph["nodes"][0]["text"].as_str().unwrap().len() <= 360);
+	let detail = read_graph_view(path, false, false, Some(&hot.id), Some("group")).unwrap();
+	assert_eq!(detail["nodes"].as_array().unwrap().len(), 1);
+	assert_eq!(detail["nodes"][0]["text"], hot.text());
+	assert_eq!(detail["nodes"][0]["vector_dimensions"], 2);
+	assert!(detail["nodes"][0].get("vector").is_none());
+	let cold_detail = read_graph_view(path, true, false, Some(&cold.id), Some("cold")).unwrap();
+	assert_eq!(cold_detail["nodes"][0]["cold"], true);
+	assert_eq!(cold_detail["nodes"][0]["text"], "Cold body");
+	assert_eq!(std::fs::read(&file).unwrap(), before);
+}
+
+#[test]
+fn graph_export_missing_store_does_not_create_files() {
+	let dir = tempfile::tempdir().unwrap();
+	let absent = dir.path().join("absent");
+	assert!(read_graph(absent.to_str().unwrap(), false).is_err());
+	assert!(!absent.exists());
+}
