+#[test]
+fn access_heat_uses_order_and_preserves_relevance() {
+	let cfg = RetrievalConfig {
+		qbst_access_weight: 0.0,
+		..Default::default()
+	};
+	assert_eq!(qbst(&cfg, 0, Some(32)), qbst(&cfg, 0, Some(0)) * 0.5);
+	assert_eq!(qbst(&cfg, 0, None), 0.0);
+	let old = SystemTime::UNIX_EPOCH + Duration::from_secs(1);
+	let recent = old + Duration::from_secs(1);
+	let make = |id: &str, at, score| {
+		let mut entity = test_support::entity(id);
+		entity.accessed_at = at;
+		ScoredEntity { entity, score }
+	};
+	let mut rows = vec![
+		make("cold", Some(old), 1.0),
+		make("hot", Some(recent), 1.0),
+		make("unrelated", Some(recent), 0.0),
+	];
+	apply_boosts(&cfg, &mut rows, &[recent, old]);
+	assert!(rows[1].score > rows[0].score);
+	let scores: Vec<_> = rows.iter().map(|r| r.score).collect();
+	// Moving every wall timestamp by decades without changing access order is inert.
+	let shift = Duration::from_secs(50 * 365 * 86400);
+	let mut shifted = vec![
+		make("cold", Some(old + shift), 1.0),
+		make("hot", Some(recent + shift), 1.0),
+		make("unrelated", Some(recent + shift), 0.0),
+	];
+	apply_boosts(&cfg, &mut shifted, &[recent + shift, old + shift]);
+	assert_eq!(scores, shifted.iter().map(|r| r.score).collect::<Vec<_>>());
+	assert_eq!(
+		rows[2].score, 0.0,
+		"heat alone cannot turn zero relevance into a match"
+	);
+}
