+/// A graph projection of every persisted tier, including superseded records.
+/// Opens only an existing LMDB environment and never creates a database or
+/// acquires a write transaction. Safe to inspect a store owned by another daemon.
+pub fn read_graph(dir: &str, include_vectors: bool) -> Result<serde_json::Value, String> {
+	read_graph_view(dir, include_vectors, false, None, None)
+}
+
+pub fn read_graph_view(
+	dir: &str,
+	include_vectors: bool,
+	summary: bool,
+	node: Option<&str>,
+	group: Option<&str>,
+) -> Result<serde_json::Value, String> {
+	use heed::types::{Bytes, Str};
+	use serde_json::{json, Value};
+	let path = std::path::Path::new(dir);
+	if !path.join("data.mdb").is_file() {
+		return Err(format!("no memory database at {dir}"));
+	}
+	// SAFETY: LMDB coordinates readers with its existing writer through the
+	// shared lock file. READ_ONLY forbids writes to the data map. The caller must
+	// retain the memory-owned file; this function never truncates or replaces it.
+	let env = unsafe {
+		heed::EnvOpenOptions::new()
+			.max_dbs(32)
+			.flags(heed::EnvFlags::READ_ONLY)
+			.open(path)
+	}
+	.map_err(|e| e.to_string())?;
+	let txn = env.read_txn().map_err(|e| e.to_string())?;
+	let memory = env
+		.open_database::<Str, Bytes>(&txn, Some(crate::MEMORY_DB))
+		.map_err(|e| e.to_string())?;
+	let memory = memory.or(
+		env
+			.open_database::<Str, Bytes>(&txn, Some("kern"))
+			.map_err(|e| e.to_string())?,
+	);
+	let memory = match memory {
+		Some(db) => db,
+		None => {
+			let names = env
+				.open_database::<Str, Bytes>(&txn, None)
+				.map_err(|e| e.to_string())?
+				.map(|db| {
+					db.iter(&txn).map(|rows| {
+						rows
+							.filter_map(|r| r.ok().map(|(key, _)| key.to_string()))
+							.collect::<Vec<_>>()
+					})
+				})
+				.transpose()
+				.map_err(|e| e.to_string())?
+				.unwrap_or_default();
+			return Err(format!(
+				"unrecognized memory store tables: {}",
+				names.join(", ")
+			));
+		}
+	};
+	let mut nodes = Vec::new();
+	let mut edges = Vec::new();
+	let mut groups = Vec::new();
+	let entity = |mut e: Entity,
+	              cold: bool,
+	              group: &str,
+	              dimensions: Option<usize>|
+	 -> Result<Value, String> {
+		let dimensions = dimensions.unwrap_or(e.vector.len());
+		let gnn_dimensions = e.gnn_vector.len();
+		let text = e.text();
+		let confidence = e.conf_mean();
+		let access_count = e.access_count.value_i32();
+		let kind = e.kind.as_str();
+		if summary {
+			return Ok(
+				json!({"id":e.id,"kind_label":kind,"text":text.chars().take(360).collect::<String>(),"text_bytes":text.len(),"score":e.score,"conf":confidence,"access_total":access_count,"accessed_at":e.accessed_at,"source":e.source,"memory":group,"cold":cold,"created_at":e.created_at,"status":e.status,"vector_dimensions":dimensions}),
+			);
+		}
+		let temporal =
+			json!({"valid_from":e.valid_from,"valid_to":e.valid_to,"invalidated_at":e.invalidated_at});
+		if !include_vectors {
+			e.vector = Default::default();
+			e.gnn_vector = Default::default();
+		}
+		let mut value = serde_json::to_value(&e).map_err(|e| e.to_string())?;
+		value["text"] = json!(text);
+		value["conf"] = json!(confidence);
+		value["kind_label"] = json!(kind);
+		value["access_total"] = json!(access_count);
+		value["memory"] = json!(group);
+		value["cold"] = json!(cold);
+		value["temporal"] = temporal;
+		value["vector_dimensions"] = json!(dimensions);
+		value["gnn_dimensions"] = json!(gnn_dimensions);
+		if !include_vectors {
+			value.as_object_mut().unwrap().remove("vector");
+			value.as_object_mut().unwrap().remove("gnn_vector");
+		}
+		Ok(value)
+	};
+	for item in memory.iter(&txn).map_err(|e| e.to_string())? {
+		let (key, bytes) = item.map_err(|e| e.to_string())?;
+		if group.is_some_and(|group| group != key) {
+			continue;
+		}
+		let mut row = crate::decode_memory_row(bytes)
+			.map_err(|e| e.to_string())?
+			.stored
+			.into_memory();
+		for (_, e) in std::mem::take(&mut row.entities) {
+			if node.is_none_or(|id| e.id == id) {
+				nodes.push(entity(e, false, &row.id, None)?);
+			}
+		}
+		for (_, mut edge) in std::mem::take(&mut row.reasons) {
+			if node.is_some_and(|id| edge.from != id && edge.to != id) {
+				continue;
+			}
+			if summary {
+				edges.push(json!({"id":edge.id,"from":edge.from,"to":edge.to,"to_memory_id":edge.to_memory_id,"kind_code":edge.kind as i32,"score":edge.score,"memory":row.id}));
+				continue;
+			}
+			let dimensions = edge.vector.len();
+			let kind = edge.kind as i32;
+			if !include_vectors {
+				edge.vector = Default::default();
+			}
+			let mut value = serde_json::to_value(&edge).map_err(|e| e.to_string())?;
+			value["kind_code"] = json!(kind);
+			value["vector_dimensions"] = json!(dimensions);
+			if !include_vectors {
+				value.as_object_mut().unwrap().remove("vector");
+			}
+			edges.push(value);
+		}
+		if summary || node.is_some() {
+			groups.push(json!({"id":row.id,"root_id":row.root_id,"focus_text":row.focus_text,"parent":row.parent,"children":row.children,"refs":row.refs,"claim_kinds":row.claim_kinds,"claim_kind_parents":row.claim_kind_parents,"mass":row.mass}));
+			continue;
+		}
+		if !include_vectors {
+			row.focus_vec.clear();
+			row.gnn_weights.clear();
+		}
+		groups.push(serde_json::to_value(row).map_err(|e| e.to_string())?);
+	}
+	if group.is_none() || group == Some("cold") {
+		if let Some(cold) = env
+			.open_database::<Str, Bytes>(&txn, Some(crate::COLD_DB))
+			.map_err(|e| e.to_string())?
+		{
+			let vectors = env
+				.open_database::<Str, Bytes>(&txn, Some(crate::COLD_VEC_DB))
+				.map_err(|e| e.to_string())?;
+			for item in cold.iter(&txn).map_err(|e| e.to_string())? {
+				let (id, bytes) = item.map_err(|e| e.to_string())?;
+				if node.is_some_and(|node| node != id) {
+					continue;
+				}
+				let row = decode_cold(bytes).map_err(|e| e.to_string())?;
+				let raw = match vectors {
+					Some(db) => db.get(&txn, id).map_err(|e| e.to_string())?,
+					None => None,
+				};
+				let dimensions = raw.map_or(0, |v| v.len() / 4);
+				let vector = if include_vectors {
+					raw.map(decode_vec).unwrap_or_default()
+				} else {
+					Default::default()
+				};
+				nodes.push(entity(
+					row.into_entity(vector),
+					true,
+					"cold",
+					Some(dimensions),
+				)?);
+			}
+		}
+	}
+	Ok(
+		json!({"schema":"memory.graph.v1","store":dir,"nodes":nodes,"edges":edges,"groups":groups,"vectors_included":include_vectors}),
+	)
+}
