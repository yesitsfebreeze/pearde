+					id: id.into(),
+					from: "hub".into(),
+					to: "missing-peer".into(),
+					kind,
+					score: 1.,
+					..Default::default()
+				},
+			);
+		}
+		graph::reason::add_reason(
+			memory,
+			Reason {
+				id: "self-loop".into(),
+				from: "hub".into(),
+				to: "hub".into(),
+				text: "One stored self-loop".into(),
+				score: 0.99,
+				..Default::default()
+			},
