+#[cfg(unix)]
+fn provenance_seed(dir: &Path) {
+	use base::base_types::{mk_entity, EntityKind, EntityStatus, Memory, Reason, ReasonKind, Source};
+	use std::time::UNIX_EPOCH;
+	let path = dir.to_str().unwrap();
+	let _writer = store_core::lock::acquire(path, "provenance-fixture").unwrap();
+	let store = store_core::Store::open(path).unwrap();
+	let mut root = Memory::new("root", "");
+	root.children.push("facts".into());
+	let mut facts = Memory::new("facts", "release facts");
+	facts.parent = "root".into();
+	for (id, text, source, created, updated) in [
+		(
+			"old-fact-exact",
+			"Release deadline is Monday",
+			"old-plan.md",
+			Some(1_700_000_000),
+			Some(1_700_000_100),
+		),
+		(
+			"new-fact-exact",
+			"Release deadline is Friday",
+			"new-plan.md",
+			Some(1_700_100_000),
+			Some(1_700_200_000),
+		),
+		(
+			"legacy-fact-exact",
+			"Release venue is unspecified",
+			"legacy-notes.md",
+			None,
+			None,
+		),
+	] {
+		let mut e = mk_entity(id, text, 1., EntityKind::Fact);
+		e.source = Source::File {
+			path: source.into(),
+			section: String::new(),
+			title: String::new(),
+			author: String::new(),
+			url: format!("https://fixture.invalid/{source}"),
+			commit: None,
+		};
+		e.vector = vec![1., 0., 0.].into();
+		e.created_at = created.map(|s| UNIX_EPOCH + Duration::from_secs(s));
+		e.updated_at = updated.map(|s| UNIX_EPOCH + Duration::from_secs(s));
+		e.valid_from = e.created_at;
+		if id == "old-fact-exact" {
+			e.status = EntityStatus::Superseded;
+			e.superseded_by = "new-fact-exact".into();
+			e.valid_to = Some(UNIX_EPOCH + Duration::from_secs(1_700_100_000));
+			e.invalidated_at = Some(UNIX_EPOCH + Duration::from_secs(1_700_200_000));
+		}
+		facts.entities.insert(id.into(), e);
+	}
+	graph::reason::add_reason(
+		&mut facts,
+		Reason {
+			id: "revision-edge-exact".into(),
+			from: "new-fact-exact".into(),
+			to: "old-fact-exact".into(),
+			kind: ReasonKind::Supersedes,
+			text: "New signed plan changes Monday to Friday".into(),
+			score: 1.,
+			..Default::default()
+		},
+	);
+	store.save_one_memory(&root).unwrap();
+	store.save_one_memory(&facts).unwrap();
+}
+
+#[cfg(unix)]
+async fn provenance_reads(client: &mut Process) -> Vec<Value> {
+	let default = client
+		.request(json!({"op":"query", "text":"Release deadline", "k":10}))
+		.await
+		.unwrap();
+	assert!(!default["entities"]
+		.as_array()
+		.unwrap()
+		.iter()
+		.any(|e| e["id"] == "old-fact-exact"));
+	let history = client
+		.request(json!({"op":"query", "text":"Release deadline", "k":10, "include_history":true}))
+		.await
+		.unwrap();
+	let rows = history["entities"].as_array().unwrap();
+	let mut metadata = Vec::new();
+	for (id, source, status, created, updated) in [
+		(
+			"new-fact-exact",
+			"new-plan.md",
+			"active",
+			Some(1_700_100_000_000i64),
+			Some(1_700_200_000_000i64),
+		),
+		(
+			"old-fact-exact",
+			"old-plan.md",
+			"superseded",
+			Some(1_700_000_000_000i64),
+			Some(1_700_000_100_000i64),
+		),
+		("legacy-fact-exact", "legacy-notes.md", "active", None, None),
+	] {
+		let ranked = rows
+			.iter()
+			.find(|e| e["id"] == id)
+			.expect("history retains every seeded identity");
+		let detail = client.request(json!({"op":"get", "id":id})).await.unwrap();
+		let compact = client
+			.request(json!({"op":"get", "id":id, "compact":true}))
+			.await
+			.unwrap();
+		assert_eq!(ranked["source"]["object_id"], source);
+		assert_eq!(ranked["source"], detail["source"]);
+		assert_eq!(ranked["provenance"], detail["provenance"]);
+		assert_eq!(detail["provenance"], compact["provenance"]);
+		let p = &detail["provenance"];
+		assert_eq!(p["schema"], "memory.provenance.v1");
+		assert_eq!(p["status"], status);
+		assert_eq!(p["created_at_ms"], json!(created));
+		assert_eq!(p["updated_at_ms"], json!(updated));
+		assert!(p["observed_at_ms"].is_null());
+		assert_eq!(
+			p["freshness"],
+			if created.is_some() {
+				"recorded"
+			} else {
+				"unknown"
+			}
+		);
+		if id == "old-fact-exact" {
+			assert_eq!(p["superseded_by"], "new-fact-exact");
+			assert_eq!(p["invalidated_at_ms"], 1_700_200_000_000i64);
+		}
+		if id != "legacy-fact-exact" {
+			for e in [
+				&ranked["edges"][0],
+				&detail["edges"][0],
+				&compact["edges"][0],
+			] {
+				assert_eq!(e["id"], "revision-edge-exact");
+				assert_eq!(e["kind_label"], "supersedes");
+				assert_eq!(e["from"], "new-fact-exact");
+				assert_eq!(e["to"], "old-fact-exact");
+			}
+			assert!(detail["edges"][0]["text"]
+				.as_str()
+				.unwrap()
+				.contains("Monday to Friday"));
+			assert!(compact["edges"][0].get("text").is_none());
+		}
+		metadata.push(p.clone());
+	}
+	let batch = client
+		.request(json!({"op":"query", "ids":["new-fact-exact", "old-fact-exact", "legacy-fact-exact"]}))
+		.await
+		.unwrap();
+	assert_eq!(batch["missing"], json!([]));
+	for (row, expected) in batch["results"].as_array().unwrap().iter().zip(&metadata) {
+		assert_eq!(&row["provenance"], expected);
+	}
+	assert!(client
+		.request(json!({"op":"get", "id":"missing-evidence-exact"}))
+		.await
+		.is_err());
+	metadata
+}
+
+#[cfg(unix)]
+#[tokio::test(flavor = "multi_thread", worker_threads = 4)]
+async fn provenance_local_and_attached_reads_preserve_revisions_dates_and_unknowns() {
+	use std::os::unix::fs::MetadataExt;
+	let root = tempfile::Builder::new()
+		.prefix("mp-")
+		.tempdir_in("/tmp")
+		.unwrap();
+	let dir = root.path().join("store");
+	provenance_seed(&dir);
+	let (url, http) =
+		test_support::spawn_http(test_support::fixed_vec_embed_app(vec![1., 0., 0.])).await;
+	let mut local = Process::start(settings(&dir, &url)).await;
+	let expected = provenance_reads(&mut local).await;
+	local.stop().await;
+	let (mut daemon, endpoint) = owner_attachment_daemon(root.path(), &url).await;
+	let transport::typed::Endpoint::Unix(socket) = endpoint;
+	let cfg = json!({"dir":dir,"owner":{"endpoint":socket,"timeout_ms":2000}});
+	let lock = std::fs::read(dir.join("writer.lock")).unwrap();
+	let inode = std::fs::metadata(dir.join("writer.lock")).unwrap().ino();
+	let mut first = Process::start(cfg.clone()).await;
+	let mut second = Process::start(cfg).await;
+	assert_eq!(provenance_reads(&mut first).await, expected);
+	first.stop().await;
+	assert!(daemon.try_wait().unwrap().is_none());
+	assert_eq!(provenance_reads(&mut second).await, expected);
+	assert_eq!(std::fs::read(dir.join("writer.lock")).unwrap(), lock);
+	assert_eq!(
+		std::fs::metadata(dir.join("writer.lock")).unwrap().ino(),
+		inode
+	);
+	second.stop().await;
+	assert!(daemon.try_wait().unwrap().is_none());
+	daemon.kill().await.unwrap();
+	daemon.wait().await.unwrap();
+	http.abort();
+}
