+	let scored = vec![retrieval::expand::ScoredEntity {
+		entity: srv.graph.read().memories["kx"].entities["hub"].clone(),
+		score: 1.,
+	}];
+	let none = std::collections::HashSet::new();
+	let rows = srv.entity_json(&scored, 1, &none, &none);
+	let row = &rows[0];
+	assert_eq!(row["edges_total"], EDGES + 2);
+	assert_eq!(row["edges_more"], true);
+	assert_eq!(row["edges_scope"], "enriched_or_lifecycle");
+	let edges = row["edges"].as_array().unwrap();
+	assert_eq!(edges.len(), QUERY_MAX_EDGES);
+	assert_eq!(edges.iter().filter(|e| e["id"] == "self-loop").count(), 1);
+	assert_eq!(edges[0]["id"], "blank-lifecycle");
+	assert_eq!(edges[0]["kind"], ReasonKind::Supersedes as i32);
+	assert_eq!(edges[0]["kind_label"], "supersedes");
+	assert_eq!(edges[0]["to"], "missing-peer");
+	assert_eq!(edges[0]["text"], "");
+	assert!(!edges.iter().any(|e| e["id"] == "blank-similarity"));
+	assert!(srv
+		.tool_query(&serde_json::json!({"id":"missing-peer"}))
+		.is_err());
+	let plain = srv
+		.tool_query(&serde_json::json!({"id":"hub", "edge_limit":0}))
+		.unwrap();
+	assert_eq!(
+		plain["edges_total"],
+		EDGES + 4,
+		"get keeps its existing adjacency pagination, including both self-loop entries"
+	);
+	let bare = retrieval::expand::ScoredEntity {
+		entity: test_support::entity("absent-from-graph"),
+		score: 1.,
+	};
+	let rows = srv.entity_json(&[bare], 1, &none, &none);
+	assert_eq!(rows[0]["edges_total"], 0);
+	assert_eq!(rows[0]["edges_more"], false);
+}
