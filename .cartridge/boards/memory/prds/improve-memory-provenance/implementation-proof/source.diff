+
+// Recorded clocks describe this row, never a fresh observation of its source.
+fn provenance(entity: &Entity) -> Value {
+	let clocks = [
+		("created_at_ms", entity.created_at),
+		("updated_at_ms", entity.updated_at),
+		("valid_from_ms", entity.valid_from),
+		("valid_to_ms", entity.valid_to),
+		("invalidated_at_ms", entity.invalidated_at),
+		("valid_until_ms", entity.valid_until),
+	];
+	let mut value = json!({
+		"schema": "memory.provenance.v1",
+		"status": if entity.is_superseded() { "superseded" } else { "active" },
+		"review": entity.review,
+		"superseded_by": (!entity.superseded_by.is_empty()).then_some(&entity.superseded_by),
+		"observed_at_ms": null,
+	});
+	let mut unrepresentable = Vec::new();
+	for (name, clock) in clocks {
+		let millis = clock.and_then(unix_millis);
+		if clock.is_some() && millis.is_none() {
+			unrepresentable.push(name);
+		}
+		value[name] = json!(millis);
+	}
+	value["freshness"] = json!(
+		if entity.created_at.is_none() && entity.updated_at.is_none() {
+			"unknown"
+		} else if value["created_at_ms"].is_null() && value["updated_at_ms"].is_null() {
+			"unrepresentable"
+		} else {
+			"recorded"
+		}
+	);
+	value["unrepresentable_clocks"] = json!(unrepresentable);
+	value
+}
+
+// Signed Unix milliseconds, rounded toward negative infinity. In particular,
+// one nanosecond before epoch is -1ms, never a fabricated epoch timestamp.
+fn unix_millis(time: std::time::SystemTime) -> Option<i64> {
+	let millis = match time.duration_since(std::time::UNIX_EPOCH) {
+		Ok(d) => i128::from(d.as_secs()) * 1000 + i128::from(d.subsec_millis()),
+		Err(error) => {
+			let d = error.duration();
+			-(i128::from(d.as_secs()) * 1000
+				+ i128::from(d.subsec_millis())
+				+ i128::from(d.subsec_nanos() % 1_000_000 != 0))
+		}
+	};
+	i64::try_from(millis).ok()
+}
