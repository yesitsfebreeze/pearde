@@ -0,0 +1,166 @@
+use super::*;
+use base::base_types::{
+	mk_entity, EntityKind, EntityStatus, Memory, Reason, ReasonKind, ReviewState,
+};
+use std::sync::Arc;
+use std::time::{Duration, UNIX_EPOCH};
+
+#[test]
+fn provenance_milliseconds_floor_across_epoch_and_refuse_overflow() {
+	for (nanos, positive, negative) in [
+		(0, 0, 0),
+		(1, 0, -1),
+		(999_999, 0, -1),
+		(1_000_000, 1, -1),
+		(1_000_001, 1, -2),
+		(1_234_567_890, 1234, -1235),
+	] {
+		assert_eq!(
+			unix_millis(UNIX_EPOCH + Duration::from_nanos(nanos)),
+			Some(positive)
+		);
+		assert_eq!(
+			unix_millis(UNIX_EPOCH - Duration::from_nanos(nanos)),
+			Some(negative)
+		);
+	}
+	if let Some(huge) = UNIX_EPOCH.checked_add(Duration::from_secs(i64::MAX as u64 / 1000 + 1)) {
+		assert_eq!(unix_millis(huge), None);
+		let mut e = Entity {
+			created_at: Some(huge),
+			..Default::default()
+		};
+		let p = provenance(&e);
+		assert_eq!(p["freshness"], "unrepresentable");
+		assert!(p["created_at_ms"].is_null());
+		assert_eq!(p["unrepresentable_clocks"], json!(["created_at_ms"]));
+		e.updated_at = Some(UNIX_EPOCH);
+		assert_eq!(provenance(&e)["freshness"], "recorded");
+	} else {
+		eprintln!("SystemTime range is narrower than signed Unix milliseconds on this platform; overflow fixture cannot be constructed");
+	}
+}
+
+#[test]
+fn provenance_keeps_missing_partial_and_lifecycle_clocks_distinct() {
+	let mut e = Entity::default();
+	let p = provenance(&e);
+	assert_eq!(p["freshness"], "unknown");
+	for name in [
+		"created_at_ms",
+		"updated_at_ms",
+		"observed_at_ms",
+		"valid_from_ms",
+		"valid_to_ms",
+		"invalidated_at_ms",
+		"valid_until_ms",
+	] {
+		assert!(p[name].is_null(), "{name}: {p}");
+	}
+	assert_eq!(p["unrepresentable_clocks"], json!([]));
+	e.updated_at = Some(UNIX_EPOCH + Duration::from_millis(15));
+	let p = provenance(&e);
+	assert_eq!(p["freshness"], "recorded");
+	assert!(p["created_at_ms"].is_null());
+	assert!(p["observed_at_ms"].is_null());
+	e.created_at = Some(UNIX_EPOCH + Duration::from_millis(10));
+	e.valid_from = Some(UNIX_EPOCH - Duration::from_nanos(1));
+	e.valid_to = Some(UNIX_EPOCH + Duration::from_millis(20));
+	e.invalidated_at = Some(UNIX_EPOCH + Duration::from_millis(25));
+	e.valid_until = Some(UNIX_EPOCH + Duration::from_millis(30));
+	e.status = EntityStatus::Superseded;
+	e.review = ReviewState::Pending;
+	e.superseded_by = "new-exact-id".into();
+	let p = provenance(&e);
+	assert_eq!(p["created_at_ms"], 10);
+	assert_eq!(p["updated_at_ms"], 15);
+	assert_eq!(p["valid_from_ms"], -1);
+	assert_eq!(p["valid_to_ms"], 20);
+	assert_eq!(p["invalidated_at_ms"], 25);
+	assert_eq!(p["valid_until_ms"], 30);
+	assert_eq!(p["status"], "superseded");
+	assert_eq!(p["review"], "pending");
+	assert_eq!(p["superseded_by"], "new-exact-id");
+}
+
+#[test]
+fn provenance_rendering_preserves_hot_cold_entity_store_and_lock_state() {
+	let tmp = tempfile::tempdir().unwrap();
+	let path = tmp.path().to_str().unwrap();
+	let _claim = store_core::lock::acquire(path, "pure-projection-fixture").unwrap();
+	let store = Arc::new(store_core::Store::open(path).unwrap());
+	let mut e = mk_entity("old-exact", "The old recorded fact", 1., EntityKind::Fact);
+	e.created_at = Some(UNIX_EPOCH + Duration::from_secs(5));
+	e.updated_at = Some(UNIX_EPOCH + Duration::from_secs(8));
+	e.status = EntityStatus::Superseded;
+	e.superseded_by = "new-exact".into();
+	e.valid_until = Some(UNIX_EPOCH + Duration::from_secs(9));
+	let before_entity = format!("{e:?}");
+	let mut memory = Memory::new("facts", "fixture");
+	memory.entities.insert(e.id.clone(), e.clone());
+	graph::reason::add_reason(
+		&mut memory,
+		Reason {
+			id: "r".into(),
+			from: "new-exact".into(),
+			to: e.id.clone(),
+			kind: ReasonKind::Supersedes,
+			text: "Recorded replacement".into(),
+			..Default::default()
+		},
+	);
+	store.save_one_memory(&memory).unwrap();
+	let mut cold = e.clone();
+	cold.id = "cold-exact".into();
+	store.cold_spill(&cold).unwrap();
+	let mut g = GraphGnn::new();
+	g.memories.insert("facts".into(), memory);
+	g.index_entity(&e.id, "facts");
+	g.set_store(store.clone());
+	let before_graph = format!("{:?}", g.memories["facts"]);
+	let bytes = std::fs::read(tmp.path().join("data.mdb")).unwrap();
+	let lock = std::fs::read(tmp.path().join("writer.lock")).unwrap();
+	#[cfg(unix)]
+	let inode = {
+		use std::os::unix::fs::MetadataExt;
+		std::fs::metadata(tmp.path().join("writer.lock"))
+			.unwrap()
+			.ino()
+	};
+	let ranked = base_entity_json(&e, 1.);
+	let plain = entity_detail_by_id(&g, &e.id, &Projection::default()).unwrap();
+	let compact = entity_detail_by_id(
+		&g,
+		&e.id,
+		&Projection {
+			compact: true,
+			..Default::default()
+		},
+	)
+	.unwrap();
+	let cold_read = entity_detail_by_id(&g, &cold.id, &Projection::default()).unwrap();
+	for read in [&plain, &compact, &cold_read] {
+		assert_eq!(read["provenance"], ranked["provenance"]);
+		assert_eq!(read["source"], ranked["source"]);
+		assert_eq!(read["expired"], true);
+	}
+	assert_eq!(plain["edges"][0]["kind_label"], "supersedes");
+	assert!(compact["edges"][0].get("text").is_none());
+	assert_eq!(cold_read["cold"], true);
+	assert_eq!(cold_read["edges_total"], 0);
+	assert!(entity_detail_by_id(&g, "new-exact", &Projection::default()).is_none());
+	assert_eq!(format!("{e:?}"), before_entity);
+	assert_eq!(format!("{:?}", g.memories["facts"]), before_graph);
+	assert_eq!(std::fs::read(tmp.path().join("data.mdb")).unwrap(), bytes);
+	assert_eq!(std::fs::read(tmp.path().join("writer.lock")).unwrap(), lock);
+	#[cfg(unix)]
+	{
+		use std::os::unix::fs::MetadataExt;
+		assert_eq!(
+			std::fs::metadata(tmp.path().join("writer.lock"))
+				.unwrap()
+				.ino(),
+			inode
+		);
+	}
+}
