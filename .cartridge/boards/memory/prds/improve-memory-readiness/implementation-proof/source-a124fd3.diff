+/// A momentary observation, never authorization to mutate or open a graph.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum Availability {
+	Missing,
+	Free,
+	Held,
+	Unreadable,
+}
+
+/// Sample only an existing regular lock inode. Callers must exclude their own
+/// writer initialization and never call this while already owning that store.
+pub fn observe(data_dir: &Path) -> Availability {
+	observe_with(data_dir, || {})
+}
+fn observe_with(data_dir: &Path, before_open: impl FnOnce()) -> Availability {
+	let path = data_dir.join(LOCK_FILE);
+	let metadata = match std::fs::symlink_metadata(&path) {
+		Ok(metadata) if metadata.is_file() => metadata,
+		Err(error) if error.kind() == std::io::ErrorKind::NotFound => return Availability::Missing,
+		_ => return Availability::Unreadable,
+	};
+	before_open();
+	let open = || {
+		let mut options = OpenOptions::new();
+		options.read(true);
+		#[cfg(unix)]
+		{
+			use std::os::unix::fs::OpenOptionsExt;
+			options.custom_flags(libc::O_NOFOLLOW | libc::O_NONBLOCK);
+		}
+		#[cfg(windows)]
+		{
+			use std::os::windows::fs::OpenOptionsExt;
+			// FILE_FLAG_OPEN_REPARSE_POINT: inspect the link itself, never its target.
+			options.custom_flags(0x00200000);
+		}
+		options.open(&path)
+	};
+	let checked = || -> std::io::Result<File> {
+		let file = open()?;
+		let opened = file.metadata()?;
+		if !opened.is_file() {
+			return Err(std::io::Error::other("not regular"));
+		}
+		#[cfg(unix)]
+		{
+			use std::os::unix::fs::MetadataExt;
+			if (metadata.dev(), metadata.ino()) != (opened.dev(), opened.ino()) {
+				return Err(std::io::Error::other("identity changed"));
+			}
+		}
+		#[cfg(windows)]
+		{
+			use std::os::windows::fs::MetadataExt;
+			if opened.file_attributes() & 0x400 != 0 {
+				return Err(std::io::Error::other("reparse point"));
+			}
+		}
+		let second = open()?;
+		if !second.metadata()?.is_file()
+			|| same_file::Handle::from_file(file.try_clone()?)? != same_file::Handle::from_file(second)?
+		{
+			return Err(std::io::Error::other("identity changed"));
+		}
+		Ok(file)
+	};
+	let Ok(file) = checked() else {
+		return Availability::Unreadable;
+	};
+	match file.try_lock() {
+		Ok(()) => Availability::Free,
+		Err(std::fs::TryLockError::WouldBlock) => Availability::Held,
+		Err(_) => Availability::Unreadable,
+	}
+}
