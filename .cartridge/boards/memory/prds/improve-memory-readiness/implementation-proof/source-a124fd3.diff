+#[cfg(unix)]
+#[tokio::test(flavor = "multi_thread", worker_threads = 4)]
+async fn readiness_status_blocked_probe_keeps_cache_responsive_and_never_retries() {
+	let root = tempfile::Builder::new()
+		.prefix("ready-deadline-")
+		.tempdir_in("/tmp")
+		.unwrap();
+	let socket = root.path().join("owner.sock");
+	let listener = tokio::net::UnixListener::bind(&socket).unwrap();
+	let (entered, wait) = tokio::sync::oneshot::channel();
+	let server = tokio::spawn(async move {
+		let (stream, _) = listener.accept().await.unwrap();
+		let mut lines = BufReader::new(stream).lines();
+		let _: Value = serde_json::from_str(&lines.next_line().await.unwrap().unwrap()).unwrap();
+		entered.send(()).unwrap();
+		assert!(lines.next_line().await.unwrap().is_none());
+		assert!(
+			tokio::time::timeout(Duration::from_millis(100), listener.accept())
+				.await
+				.is_err()
+		);
+	});
+	let missing = root.path().join("missing");
+	let mut client =
+		Process::start(json!({"dir":missing,"owner":{"endpoint":socket,"timeout_ms":300}})).await;
+	let start = tokio::time::Instant::now();
+	client
+		.send(json!({"id":101,"call":"memory","args":{"op":"status","probe":true}}))
+		.await;
+	wait.await.unwrap();
+	client
+		.send(json!({"id":102,"call":"memory","args":{"op":"status"}}))
+		.await;
+	let cached = client.read().await;
+	assert_eq!(cached["reply"], 102);
+	assert_eq!(cached["data"]["view"], "cached");
+	client
+		.send(json!({"id":103,"call":"memory","args":{"op":"status","probe":true}}))
+		.await;
+	let ongoing = client.read().await;
+	assert_eq!(ongoing["reply"], 103);
+	assert_eq!(ongoing["data"]["reason"], "probe_in_progress");
+	let expired = client.read().await;
+	assert_eq!(expired["reply"], 101);
+	assert_eq!(expired["data"]["reason"], "timeout");
+	assert!(start.elapsed() < Duration::from_secs(2));
+	assert!(!missing.exists());
+	assert!(socket.exists());
+	server.await.unwrap();
+	client.stop().await;
+}
