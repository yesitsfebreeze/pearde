index 0000000..4964d72
--- /dev/null
+++ b/src/cartridge_status.rs
@@ -0,0 +1,337 @@
+//! Bounded observations for the native service. This module never opens an engine.
+use super::{ServiceConfig, CALLS, ENGINE, INITIALIZATION};
+use serde_json::{json, Value};
+use std::sync::{Arc, Mutex};
+use std::time::Duration;
+use tokio::sync::Semaphore;
+use tokio::time::Instant;
+
+const QUERY_FRESHNESS: Duration = Duration::from_secs(30);
+#[derive(Clone)]
+struct Snapshot {
+	at: Instant,
+	origin: &'static str,
+	store: &'static str,
+	reason: &'static str,
+	retryable: bool,
+	pid: Option<u64>,
+	complete_failures: u64,
+	embed_wedges: u64,
+}
+impl Snapshot {
+	fn new(store: &'static str, reason: &'static str, retryable: bool, pid: Option<u64>) -> Self {
+		Self {
+			at: Instant::now(),
+			origin: "probe",
+			store,
+			reason,
+			retryable,
+			pid,
+			complete_failures: 0,
+			embed_wedges: 0,
+		}
+	}
+	fn unavailable(reason: &'static str, retryable: bool, pid: Option<u64>) -> Self {
+		Self::new("unavailable", reason, retryable, pid)
+	}
+}
+#[derive(Clone)]
+struct Semantic {
+	at: Instant,
+	pid: u64,
+	success: bool,
+}
+#[derive(Default)]
+struct Cache {
+	ticket: u64,
+	snapshot: Option<Snapshot>,
+	semantic: Option<Semantic>,
+}
+pub struct Tracker {
+	cache: Mutex<Cache>,
+	permit: Arc<Semaphore>,
+}
+impl Tracker {
+	pub fn new() -> Arc<Self> {
+		Arc::new(Self {
+			cache: Mutex::new(Cache::default()),
+			permit: Arc::new(Semaphore::new(1)),
+		})
+	}
+	pub fn begin_query(&self, op: &str, args: &Value) -> Option<u64> {
+		(op == "query" && rpc::server::semantic_query_observation_eligible(args)).then(|| self.begin())
+	}
+	pub fn record_owner_query(
+		&self,
+		ticket: Option<u64>,
+		result: &Result<transport::owner::ObservedRead, transport::owner::OwnerError>,
+	) {
+		match result {
+			Ok(read) => self.record_query(ticket, Some(read.pid), true),
+			Err(error) if error.status == "operation_failed" && error.pid.is_some() => {
+				self.record_query(ticket, error.pid, false)
+			}
+			Err(error) => {
+				let Some(ticket) = ticket else {
+					return;
+				};
+				let mut cache = self.cache.lock().unwrap();
+				if cache.ticket != ticket {
+					return;
+				}
+				cache.semantic = None;
+				let mut snapshot = Snapshot::unavailable(error.status, error.retryable, error.pid);
+				snapshot.origin = "operation";
+				cache.snapshot = Some(snapshot);
+			}
+		}
+	}
+
+	fn begin(&self) -> u64 {
+		let mut cache = self.cache.lock().unwrap();
+		cache.ticket = cache.ticket.saturating_add(1);
+		cache.ticket
+	}
+	pub fn record_query(&self, ticket: Option<u64>, pid: Option<u64>, success: bool) {
+		let Some(ticket) = ticket else {
+			return;
+		};
+		let mut cache = self.cache.lock().unwrap();
+		if ticket != cache.ticket {
+			return;
+		}
+		let mut snapshot = match pid {
+			Some(pid) => {
+				cache.semantic = Some(Semantic {
+					at: Instant::now(),
+					pid,
+					success,
+				});
+				Snapshot::new("ready", "observed_owner", false, Some(pid))
+			}
+			None => Snapshot::unavailable("owner_unavailable", true, None),
+		};
+		snapshot.origin = "operation";
+		cache.snapshot = Some(snapshot);
+	}
+	fn publish(&self, ticket: u64, snapshot: Snapshot) {
+		let mut cache = self.cache.lock().unwrap();
+		if cache.ticket == ticket {
+			cache.snapshot = Some(snapshot);
+		}
+	}
+	fn render(
+		&self,
+		cfg: &ServiceConfig,
+		view: &'static str,
+		replacement: Option<Snapshot>,
+	) -> Value {
+		let (snapshot, semantic) = {
+			let cache = self.cache.lock().unwrap();
+			(
+				replacement.or_else(|| cache.snapshot.clone()),
+				cache.semantic.clone(),
+			)
+		};
+		let mode = if matches!(cfg, ServiceConfig::Local(_)) {
+			"local"
+		} else {
+			"attached"
+		};
+		let Some(snapshot) = snapshot else {
+			return json!({"schema":"memory.status.v1","registered":true,"mode":mode,"view":view,
+    "observation":"none","age_ms":null,"state":"unknown","reason":"not_observed","retryable":true,
+    "store":{"state":"unknown","pid":null},"query":{"exact_id":"unknown","semantic":"unknown","age_ms":null},
+    "models":{"availability":"unknown","actively_probed":false,"observed_complete_failures":0,"observed_embed_wedges":0}});
+		};
+		let semantic = semantic.filter(|e| Some(e.pid) == snapshot.pid);
+		let semantic_age = semantic.as_ref().map(|e| millis(e.at.elapsed()));
+		let semantic_state = if snapshot.store != "ready" {
+			if matches!(snapshot.store, "unavailable" | "contended") {
+				"unavailable"
+			} else {
+				"unknown"
+			}
+		} else {
+			match semantic
+				.as_ref()
+				.filter(|e| e.at.elapsed() <= QUERY_FRESHNESS)
+			{
+				Some(e) if e.success => "ready",
+				Some(_) => "degraded",
+				None => "unknown",
+			}
+		};
+		let (state, reason, retryable) = match snapshot.store {
+			"ready" => match semantic_state {
+				"ready" => ("ready", "recent_semantic_query_success", false),
+				"degraded" => ("degraded", "last_query_failed", true),
+				_ => ("unknown", "semantic_query_not_observed_recently", true),
+			},
+			"uninitialized" | "starting" => ("starting", snapshot.reason, true),
+			_ => ("unavailable", snapshot.reason, snapshot.retryable),
+		};
+		json!({"schema":"memory.status.v1","registered":true,"mode":mode,"view":view,
+   "observation":snapshot.origin,"age_ms":millis(snapshot.at.elapsed()),"state":state,"reason":reason,"retryable":retryable,
+   "store":{"state":snapshot.store,"pid":snapshot.pid},
+   "query":{"exact_id":if snapshot.store == "ready" {"ready"} else {semantic_state},"semantic":semantic_state,"age_ms":semantic_age},
+   "models":{"availability":"unknown","actively_probed":false,
+    "observed_complete_failures":snapshot.complete_failures,"observed_embed_wedges":snapshot.embed_wedges}})
+	}
+	pub async fn status(
+		self: &Arc<Self>,
+		cfg: &ServiceConfig,
+		request: &Value,
+	) -> Result<Value, String> {
+		let (probe, timeout) = options(request)?;
+		if !probe {
+			return Ok(self.render(cfg, "cached", None));
+		}
+		let timeout = match cfg {
+			ServiceConfig::Attached { timeout: cap, .. } => timeout.min(*cap),
+			_ => timeout,
+		};
+		let deadline = Instant::now() + timeout;
+		let Ok(permit) = self.permit.clone().try_acquire_owned() else {
+			return Ok(self.render(
+				cfg,
+				"probe",
+				Some(Snapshot::new("starting", "probe_in_progress", true, None)),
+			));
+		};
+		let ticket = self.begin();
+		let snapshot = match tokio::time::timeout_at(deadline, CALLS.read()).await {
+			Err(_) => Snapshot::unavailable("timeout", true, None),
+			Ok(calls) => match cfg {
+				ServiceConfig::Attached { dir, endpoint, .. } => {
+					let result = transport::owner::read_observed(
+						endpoint,
+						dir,
+						deadline.saturating_duration_since(Instant::now()),
+						"ready",
+						json!({}),
+					)
+					.await;
+					// Same transport is dropped before the call/permit guards.
+					drop(calls);
+					drop(permit);
+					match result {
+						Ok(read) => ready_snapshot(&read.value, read.pid),
+						Err(error) => Snapshot::unavailable(error.status, error.retryable, error.pid),
+					}
+				}
+				ServiceConfig::Local(local) => match INITIALIZATION.try_lock() {
+					Err(_) => Snapshot::new("starting", "engine_initializing", true, None),
+					Ok(initialization) => {
+						let dir = std::path::PathBuf::from(&local.data_dir);
+						blocking_snapshot(
+							deadline,
+							permit,
+							calls,
+							initialization,
+							move || match ENGINE.get() {
+								Some(engine) => match engine.server.invoke("ready", &json!({})) {
+									Ok(value) => ready_snapshot(&value, u64::from(std::process::id())),
+									Err(_) => Snapshot::unavailable(
+										"owner_unavailable",
+										true,
+										Some(u64::from(std::process::id())),
+									),
+								},
+								None => match store::lock::observe(&dir) {
+									store::lock::Availability::Free | store::lock::Availability::Missing => {
+										Snapshot::new("uninitialized", "local_uninitialized", true, None)
+									}
+									store::lock::Availability::Held => {
+										Snapshot::new("contended", "writer_busy", true, None)
+									}
+									store::lock::Availability::Unreadable => {
+										Snapshot::unavailable("lock_unreadable", false, None)
+									}
+								},
+							},
+						)
+						.await
+					}
+				},
+			},
+		};
+		self.publish(ticket, snapshot);
+		Ok(self.render(cfg, "probe", None))
+	}
+}
+async fn blocking_snapshot(
+	deadline: Instant,
+	permit: tokio::sync::OwnedSemaphorePermit,
+	calls: tokio::sync::RwLockReadGuard<'static, ()>,
+	initialization: tokio::sync::MutexGuard<'static, ()>,
+	work: impl FnOnce() -> Snapshot + Send + 'static,
+) -> Snapshot {
+	let worker = tokio::task::spawn_blocking(move || {
+		let (_permit, _calls, _initialization) = (permit, calls, initialization);
+		work()
+	});
+	match tokio::time::timeout_at(deadline, worker).await {
+		Ok(Ok(snapshot)) => snapshot,
+		Ok(Err(_)) => Snapshot::unavailable("probe_failed", true, None),
+		Err(_) => Snapshot::unavailable("timeout", true, None),
+	}
+}
+
+fn millis(duration: Duration) -> u64 {
+	duration.as_millis().min(u128::from(u64::MAX)) as u64
+}
+fn options(value: &Value) -> Result<(bool, Duration), String> {
+	let fields = value.as_object().ok_or("invalid status request")?;
+	if fields
+		.keys()
+		.any(|key| !matches!(key.as_str(), "op" | "probe" | "timeout_ms"))
+	{
+		return Err("unknown status field".into());
+	}
+	let probe = match fields.get("probe") {
+		None => false,
+		Some(v) => v.as_bool().ok_or("status probe must be boolean")?,
+	};
+	let timeout = match fields.get("timeout_ms") {
+		Some(_) if !probe => return Err("status timeout_ms requires probe=true".into()),
+		Some(v) => v
+			.as_u64()
+			.filter(|n| (1..=60000).contains(n))
+			.ok_or("status timeout_ms must be 1..60000")?,
+		None => 2000,
+	};
+	Ok((probe, Duration::from_millis(timeout)))
+}
+fn ready_snapshot(value: &Value, pid: u64) -> Snapshot {
+	let malformed = || Snapshot::unavailable("malformed", false, Some(pid));
+	if pid == 0
+		|| value.get("pid").and_then(Value::as_u64) != Some(pid)
+		|| value.get("ok").and_then(Value::as_bool) != Some(true)
+	{
+		return malformed();
+	}
+	let Some(draining) = value.get("draining").and_then(Value::as_bool) else {
+		return malformed();
+	};
+	if draining {
+		return Snapshot::unavailable("draining", true, Some(pid));
+	}
+	let mut snapshot = Snapshot::new("ready", "observed_owner", false, Some(pid));
+	for (key, target) in [
+		("llm_complete_failed", &mut snapshot.complete_failures),
+		("llm_embed_wedges", &mut snapshot.embed_wedges),
+	] {
+		if let Some(value) = value.get(key) {
+			let Some(n) = value.as_u64() else {
+				return malformed();
+			};
+			*target = n;
+		}
+	}
+	snapshot
+}
