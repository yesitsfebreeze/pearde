+#[cfg(unix)]
+#[tokio::test(flavor = "multi_thread", worker_threads = 4)]
+async fn readiness_status_native_faults_and_credentials_are_named_without_store_effects() {
+	for mode in [
+		"malformed_health",
+		"wrong_store",
+		"malformed_ready",
+		"wrong_pid",
+		"draining",
+		"credentials",
+	] {
+		let root = tempfile::Builder::new()
+			.prefix("ready-fault-")
+			.tempdir_in("/tmp")
+			.unwrap();
+		let dir = root.path().join("store");
+		std::fs::create_dir(&dir).unwrap();
+		let lock = dir.join("writer.lock");
+		std::fs::write(&lock, "fixture-secret-holder").unwrap();
+		let socket = root.path().join("owner.sock");
+		let listener = tokio::net::UnixListener::bind(&socket).unwrap();
+		let owner_dir = dir.clone();
+		let task = tokio::spawn(async move {
+			let (stream, _) = listener.accept().await.unwrap();
+			let (read, mut write) = stream.into_split();
+			let mut lines = BufReader::new(read).lines();
+			let frame: Value = serde_json::from_str(&lines.next_line().await.unwrap().unwrap()).unwrap();
+			assert_eq!(frame["method"], "health");
+			let health = match mode {
+				"malformed_health" => Value::Null,
+				"wrong_store" => json!({"ok":true,"pid":55,"data_dir":"/"}),
+				_ => json!({"ok":true,"pid":55,"data_dir":owner_dir}),
+			};
+			write
+				.write_all(format!("{}\n", json!({"id":frame["id"],"result":health})).as_bytes())
+				.await
+				.unwrap();
+			if let Some(line) = lines.next_line().await.unwrap() {
+				let frame: Value = serde_json::from_str(&line).unwrap();
+				assert_eq!(frame["params"]["req"]["name"], "ready");
+				let ready = match mode {
+					"malformed_ready" => json!({"ok":true,"pid":55}),
+					"wrong_pid" => json!({"ok":true,"pid":56,"draining":false}),
+					_ => {
+						json!({"ok":true,"pid":55,"draining":mode=="draining","llm_complete_failed":2,"last_llm_complete_failure":"https://user:fixture-secret@example.invalid/raw"})
+					}
+				};
+				write
+					.write_all(
+						format!(
+							"{}\n",
+							json!({"id":frame["id"],"result":{"error":"","value":ready}})
+						)
+						.as_bytes(),
+					)
+					.await
+					.unwrap();
+			}
+			assert!(
+				tokio::time::timeout(Duration::from_millis(100), listener.accept())
+					.await
+					.is_err(),
+				"cached/invalid requests cannot reconnect"
+			);
+		});
+		let mut client =
+			Process::start(json!({"dir":dir,"owner":{"endpoint":socket,"timeout_ms":1000}})).await;
+		let value = client
+			.request(json!({"op":"status","probe":true}))
+			.await
+			.unwrap();
+		assert_eq!(value["registered"], true);
+		assert!(!value.to_string().contains("fixture-secret"));
+		let expected = match mode {
+			"wrong_store" => "wrong_store",
+			"draining" => "draining",
+			"credentials" => "semantic_query_not_observed_recently",
+			_ => "malformed",
+		};
+		assert_eq!(value["reason"], expected, "{mode}: {value}");
+		for request in [
+			json!({"op":"status","endpoint":"fixture-secret"}),
+			json!({"op":"status","probe":true,"timeout_ms":0}),
+			json!({"op":"status","probe":"yes"}),
+			json!({"op":"status","owner":{"op":"ingest"}}),
+		] {
+			assert!(client.request(request).await.is_err());
+		}
+		assert_eq!(
+			client.request(json!({"op":"status"})).await.unwrap()["view"],
+			"cached"
+		);
+		assert_eq!(
+			std::fs::read_to_string(&lock).unwrap(),
+			"fixture-secret-holder"
+		);
+		assert!(!dir.join("data.mdb").exists());
+		assert!(socket.exists());
+		task.await.unwrap();
+		client.stop().await;
+	}
+}
