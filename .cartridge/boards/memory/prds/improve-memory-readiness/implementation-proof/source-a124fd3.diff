+#[test]
+fn readiness_status_strict_options_and_static_counter_projection() {
+	for request in [
+		json!({"probe":"yes"}),
+		json!({"probe":true,"timeout_ms":0}),
+		json!({"probe":true,"timeout_ms":60001}),
+		json!({"timeout_ms":3}),
+		json!({"probe":true,"owner":"secret"}),
+		json!({"endpoint":"secret"}),
+	] {
+		assert!(options(&request).is_err());
+	}
+	let input = json!({"ok":true,"pid":9,"draining":false,"llm_complete_failed":2,"llm_embed_wedges":1,"last_llm_complete_failure":"https://user:credential@example.test/private"});
+	let snapshot = ready_snapshot(&input, 9);
+	let tracker = Tracker::new();
+	let view = tracker.render(&config(), "probe", Some(snapshot));
+	assert!(!view.to_string().contains("credential"));
+	assert_eq!(view["models"]["observed_complete_failures"], 2);
+	assert_eq!(view["query"]["semantic"], "unknown");
