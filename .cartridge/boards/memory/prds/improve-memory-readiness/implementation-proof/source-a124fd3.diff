+#[cfg(unix)]
+#[tokio::test(flavor = "multi_thread", worker_threads = 4)]
+async fn readiness_status_local_registration_contention_and_recovery_start_no_writer() {
+	use std::os::unix::fs::MetadataExt;
+	let root = tempfile::tempdir().unwrap();
+	let dir = root.path().join("store");
+	let (url, http) =
+		test_support::spawn_http(test_support::fixed_vec_embed_app(vec![1., 0., 0.])).await;
+	let cfg = settings(&dir, &url);
+	let mut first = Process::start(cfg.clone()).await;
+	let initial = first.request(json!({"op":"status"})).await.unwrap();
+	assert_eq!(initial["registered"], true);
+	assert_eq!(initial["state"], "unknown");
+	assert_eq!(initial["view"], "cached");
+	assert!(!dir.exists());
+	let start = first
+		.request(json!({"op":"status","probe":true}))
+		.await
+		.unwrap();
+	assert_eq!(start["state"], "starting");
+	assert_eq!(start["query"]["semantic"], "unknown");
+	assert!(!dir.exists());
+	let seeded = first
+		.request(json!({"op":"ingest","text":"The release is CEDARQUARTZ.","raw":true,"sync":true}))
+		.await
+		.unwrap();
+	assert!(seeded["doc_id"].is_string());
+	let lock = std::fs::read(dir.join("writer.lock")).unwrap();
+	let inode = std::fs::metadata(dir.join("writer.lock")).unwrap().ino();
+	let mut second = Process::start(cfg).await;
+	let busy = second
+		.request(json!({"op":"status","probe":true}))
+		.await
+		.unwrap();
+	assert_eq!(busy["registered"], true);
+	assert_eq!(busy["state"], "unavailable");
+	assert_eq!(busy["reason"], "writer_busy");
+	assert_eq!(busy["retryable"], true);
+	assert_eq!(std::fs::read(dir.join("writer.lock")).unwrap(), lock);
+	assert_eq!(
+		std::fs::metadata(dir.join("writer.lock")).unwrap().ino(),
+		inode
+	);
+	first.stop().await;
+	let after = second
+		.request(json!({"op":"status","probe":true}))
+		.await
+		.unwrap();
+	assert_eq!(after["state"], "starting");
+	assert_eq!(after["reason"], "local_uninitialized");
+	assert_eq!(std::fs::read(dir.join("writer.lock")).unwrap(), lock);
+	assert_eq!(
+		std::fs::metadata(dir.join("writer.lock")).unwrap().ino(),
+		inode
+	);
+	let query = second
+		.request(json!({"op":"query","text":"release name","k":3}))
+		.await
+		.unwrap();
+	assert!(query.to_string().contains("CEDARQUARTZ"));
+	let observed = second.request(json!({"op":"status"})).await.unwrap();
+	assert_eq!(observed["state"], "ready");
+	assert_eq!(observed["observation"], "operation");
+	assert_eq!(observed["models"]["actively_probed"], false);
+	tokio::time::sleep(Duration::from_millis(25)).await;
+	let probed = second
+		.request(json!({"op":"status","probe":true}))
+		.await
+		.unwrap();
+	assert_eq!(probed["state"], "ready");
+	assert!(probed["query"]["age_ms"].as_u64().unwrap() >= 20);
+	assert_eq!(probed["models"]["availability"], "unknown");
+	for invalid in [
+		json!({"op":"query","text":"release name","k":"bad"}),
+		json!({"op":"query","text":"release name","since":"bad"}),
+		json!({"op":"query","text":"release name","kind":"bad"}),
+		json!({"op":"query","text":"release name","claim_kind":"unknown"}),
+	] {
+		assert!(second.request(invalid).await.is_err());
+		let current = second.request(json!({"op":"status"})).await.unwrap();
+		assert_eq!(current["state"], "ready");
+		assert!(
+			current["query"]["age_ms"].as_u64().unwrap() >= probed["query"]["age_ms"].as_u64().unwrap()
+		);
+	}
+
+	// The old ready/health contracts remain available.
+	assert_eq!(
+		second.request(json!({"op":"ready"})).await.unwrap()["ok"],
+		true
+	);
+	assert_eq!(
+		second.request(json!({"op":"health"})).await.unwrap()["entities"],
+		1
+	);
+	second.stop().await;
+	http.abort();
+	let _ = http.await;
+}
