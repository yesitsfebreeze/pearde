+		json!({"ok":true,"pid":9}),
+		json!({"ok":true,"pid":8,"draining":false}),
+		json!({"ok":true,"pid":9,"draining":false,"llm_embed_wedges":"secret"}),
+	] {
+		assert_eq!(ready_snapshot(&input, 9).reason, "malformed");
