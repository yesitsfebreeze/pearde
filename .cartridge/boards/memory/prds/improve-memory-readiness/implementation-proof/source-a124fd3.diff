+#[tokio::test(flavor = "multi_thread", worker_threads = 2)]
+async fn readiness_status_timed_out_worker_keeps_admission_until_it_really_exits() {
+	let tracker = Tracker::new();
+	let cfg = config();
+	let permit = tracker.permit.clone().try_acquire_owned().unwrap();
+	let calls = CALLS.read().await;
+	let initialization = INITIALIZATION.lock().await;
+	let (release, wait) = std::sync::mpsc::channel();
+	let (entered_tx, entered_rx) = tokio::sync::oneshot::channel();
+	let pending = tokio::spawn(blocking_snapshot(
+		Instant::now() + Duration::from_millis(100),
+		permit,
+		calls,
+		initialization,
+		move || {
+			entered_tx.send(()).unwrap();
+			wait.recv_timeout(Duration::from_secs(5)).unwrap();
+			Snapshot::new("ready", "late_result", false, Some(99))
+		},
+	));
+	entered_rx.await.unwrap();
+	let cached = tracker.status(&cfg, &json!({"op":"status"})).await.unwrap();
+	assert_eq!(cached["state"], "unknown");
+	assert_eq!(
+		tracker
+			.status(&cfg, &json!({"op":"status","probe":true}))
+			.await
+			.unwrap()["reason"],
+		"probe_in_progress"
+	);
+	assert_eq!(pending.await.unwrap().reason, "timeout");
+	assert!(tracker.permit.clone().try_acquire_owned().is_err());
+	assert!(CALLS.try_write().is_err());
+	assert!(INITIALIZATION.try_lock().is_err());
+	release.send(()).unwrap();
+	tokio::time::timeout(Duration::from_secs(2), async {
+		let _permit = tracker.permit.acquire().await.unwrap();
+	})
+	.await
+	.unwrap();
+	assert_eq!(
+		tracker.status(&cfg, &json!({"op":"status"})).await.unwrap()["state"],
+		"unknown"
+	);
+}
+
+#[test]
+fn readiness_status_transport_failures_never_claim_store_or_exact_readiness() {
+	let tracker = Tracker::new();
+	let cfg = config();
+	for (reason, retryable) in [
+		("disconnected", true),
+		("timeout", true),
+		("malformed", false),
+		("wrong_store", false),
+		("incompatible", false),
+		("absent", true),
+		("stale", true),
+		("refused", false),
+	] {
+		let ticket = tracker.begin_query("query", &json!({"text":"valid"}));
+		tracker.record_query(ticket, Some(71), true);
+		let ticket = tracker.begin_query("query", &json!({"text":"uncertain"}));
+		tracker.record_owner_query(
+			ticket,
+			&Err(transport::owner::OwnerError {
+				status: reason,
+				retryable,
+				reason: "raw secret",
+				pid: Some(71),
+			}),
+		);
+		let report = tracker.render(&cfg, "cached", None);
+		assert_eq!(report["state"], "unavailable");
+		assert_eq!(report["store"]["state"], "unavailable");
+		assert_eq!(report["query"]["exact_id"], "unavailable");
+		assert_eq!(report["reason"], reason);
+		assert_eq!(report["retryable"], retryable);
+		assert_eq!(report["store"]["pid"], 71);
+		assert!(!report.to_string().contains("raw secret"));
+		let probe = tracker.begin();
+		tracker.publish(
+			probe,
+			Snapshot::new("ready", "observed_owner", false, Some(71)),
+		);
+		assert_eq!(
+			tracker.render(&cfg, "probe", None)["query"]["semantic"],
+			"unknown"
+		);
+	}
+	let ticket = tracker.begin_query("query", &json!({"text":"valid"}));
+	tracker.record_owner_query(
+		ticket,
+		&Err(transport::owner::OwnerError {
+			status: "operation_failed",
+			retryable: false,
+			reason: "secret",
+			pid: Some(71),
+		}),
+	);
+	assert_eq!(tracker.render(&cfg, "cached", None)["state"], "degraded");
+}
+#[test]
+fn readiness_status_uses_rpc_argument_validation_before_observing_queries() {
+	let tracker = Tracker::new();
+	let cfg = config();
+	let valid = json!({"text":"valid","k":2});
+	let ticket = tracker.begin_query("query", &valid);
+	tracker.record_query(ticket, Some(71), true);
+	for invalid in [
+		json!({"text":"x","k":"bad"}),
+		json!({"text":"x","k":-1}),
+		json!({"text":"x","since":"bad"}),
+		json!({"text":"x","kind":"bad"}),
+		json!({"text":"x","scheme":"bad"}),
+		json!({"text":"x","ids":["selected-id"]}),
+		json!({"text":"x","claim_kind":"dynamic"}),
+	] {
+		let ticket = tracker.begin_query("query", &invalid);
+		assert!(ticket.is_none(), "{invalid}");
+		tracker.record_query(ticket, Some(71), false);
+		assert_eq!(tracker.render(&cfg, "cached", None)["state"], "ready");
+	}
+}
