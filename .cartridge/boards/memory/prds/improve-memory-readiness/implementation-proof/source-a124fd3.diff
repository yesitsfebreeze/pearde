+#[cfg(unix)]
+#[tokio::test(flavor = "multi_thread", worker_threads = 4)]
+async fn readiness_status_attached_real_owner_restart_invalidates_query_evidence() {
+	let root = tempfile::Builder::new()
+		.prefix("ready-owner-")
+		.tempdir_in("/tmp")
+		.unwrap();
+	let dir = root.path().join("store");
+	let calls = std::sync::Arc::new(std::sync::atomic::AtomicUsize::new(0));
+	let observed = calls.clone();
+	let app = axum::Router::new().route(
+		"/api/embed",
+		axum::routing::post(move |body: axum::Json<Value>| {
+			let observed = observed.clone();
+			async move {
+				observed.fetch_add(1, std::sync::atomic::Ordering::SeqCst);
+				let n = body["input"].as_array().map_or(1, Vec::len);
+				axum::Json(json!({"embeddings":vec![vec![1.,0.,0.];n]}))
+			}
+		}),
+	);
+	let (url, http) = test_support::spawn_http(app).await;
+	let mut seed = Process::start(settings(&dir, &url)).await;
+	seed
+		.request(json!({"op":"ingest","text":"The release is CEDARQUARTZ.","raw":true,"sync":true}))
+		.await
+		.unwrap();
+	seed.stop().await;
+	let (mut daemon, endpoint) = owner_attachment_daemon(root.path(), &url).await;
+	let pid = daemon.id().unwrap();
+	let cfg = json!({"dir":dir,"owner":{"endpoint":endpoint.display(),"timeout_ms":500}});
+	let mut first = Process::start(cfg.clone()).await;
+	let mut second = Process::start(cfg).await;
+	let before = calls.load(std::sync::atomic::Ordering::SeqCst);
+	for client in [&mut first, &mut second] {
+		let status = client
+			.request(json!({"op":"status","probe":true}))
+			.await
+			.unwrap();
+		assert_eq!(status["store"]["state"], "ready");
+		assert_eq!(status["store"]["pid"], pid);
+		assert_eq!(status["query"]["semantic"], "unknown");
+		assert_eq!(status["query"]["exact_id"], "ready");
+	}
+	assert_eq!(
+		calls.load(std::sync::atomic::Ordering::SeqCst),
+		before,
+		"status must not call model"
+	);
+	second
+		.request(json!({"op":"query","text":"release","k":3}))
+		.await
+		.unwrap();
+	assert_eq!(
+		second.request(json!({"op":"status"})).await.unwrap()["state"],
+		"ready"
+	);
+	assert!(second
+		.request(json!({"op":"query","text":"release","k":"bad"}))
+		.await
+		.is_err());
+	assert_eq!(
+		second.request(json!({"op":"status"})).await.unwrap()["state"],
+		"ready"
+	);
+
+	first.stop().await;
+	assert!(daemon.try_wait().unwrap().is_none());
+	daemon.kill().await.unwrap();
+	daemon.wait().await.unwrap();
+	let down = second
+		.request(json!({"op":"status","probe":true}))
+		.await
+		.unwrap();
+	assert_eq!(down["state"], "unavailable");
+	assert_eq!(down["retryable"], true);
+	let (mut successor, _) = owner_attachment_daemon(root.path(), &url).await;
+	let new_pid = successor.id().unwrap();
+	assert_ne!(pid, new_pid);
+	let recovered = second
+		.request(json!({"op":"status","probe":true}))
+		.await
+		.unwrap();
+	assert_eq!(recovered["store"]["pid"], new_pid);
+	assert_eq!(recovered["query"]["semantic"], "unknown");
+	assert_eq!(recovered["query"]["exact_id"], "ready");
+	second
+		.request(json!({"op":"query","text":"release","k":3}))
+		.await
+		.unwrap();
+	assert_eq!(
+		second.request(json!({"op":"status"})).await.unwrap()["state"],
+		"ready"
+	);
+	second.stop().await;
+	assert!(successor.try_wait().unwrap().is_none());
+	successor.kill().await.unwrap();
+	successor.wait().await.unwrap();
+	http.abort();
+	let _ = http.await;
+}
