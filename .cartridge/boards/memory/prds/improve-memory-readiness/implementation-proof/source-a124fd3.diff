+use super::*;
+fn config() -> ServiceConfig {
+	super::super::service_configuration(json!({"dir":"not-opened-by-status"})).unwrap()
+}
+#[tokio::test(start_paused = true)]
+async fn readiness_status_cache_and_probe_do_not_refresh_semantic_age() {
+	let tracker = Tracker::new();
+	let cfg = config();
+	let empty = tracker.status(&cfg, &json!({"op":"status"})).await.unwrap();
+	assert_eq!(empty["registered"], true);
+	assert_eq!(empty["state"], "unknown");
+	assert!(empty["age_ms"].is_null());
+	let ticket = tracker.begin_query("query", &json!({"text":"private query"}));
+	tracker.record_query(ticket, Some(42), true);
+	tokio::time::advance(Duration::from_secs(20)).await;
+	let ticket = tracker.begin();
+	tracker.publish(
+		ticket,
+		Snapshot::new("ready", "observed_owner", false, Some(42)),
+	);
+	let view = tracker.render(&cfg, "cached", None);
+	assert_eq!(view["state"], "ready");
+	assert_eq!(view["age_ms"], 0);
+	assert_eq!(view["query"]["age_ms"], 20000);
+	assert_eq!(view["models"]["availability"], "unknown");
+	assert_eq!(view["models"]["actively_probed"], false);
+	assert!(!view.to_string().contains("private query"));
+	tokio::time::advance(Duration::from_secs(11)).await;
+	assert_eq!(
+		tracker.render(&cfg, "cached", None)["query"]["semantic"],
+		"unknown"
+	);
+}
+#[test]
+fn readiness_status_successor_and_late_completions_do_not_restore_old_readiness() {
+	let tracker = Tracker::new();
+	let cfg = config();
+	let ticket = tracker.begin_query("query", &json!({"text":"hello"}));
+	tracker.record_query(ticket, Some(42), true);
+	let old_query = tracker.begin_query("query", &json!({"text":"old"}));
+	let newest = tracker.begin();
+	tracker.publish(
+		newest,
+		Snapshot::new("ready", "observed_owner", false, Some(43)),
+	);
+	tracker.record_query(old_query, Some(42), true);
+	let view = tracker.render(&cfg, "cached", None);
+	assert_eq!(view["store"]["pid"], 43);
+	assert_eq!(view["query"]["semantic"], "unknown");
+	let old_probe = tracker.begin();
+	let query = tracker.begin_query("query", &json!({"text":"new"}));
+	tracker.record_query(query, Some(43), false);
+	tracker.publish(
+		old_probe,
+		Snapshot::new("ready", "observed_owner", false, Some(42)),
+	);
+	assert_eq!(tracker.render(&cfg, "cached", None)["state"], "degraded");
+	for args in [
+		json!({"id":"x","text":"ignored"}),
+		json!({"text":""}),
+		json!({}),
+	] {
+		assert!(tracker.begin_query("query", &args).is_none());
+	}
+	assert!(tracker
+		.begin_query("search", &json!({"text":"x"}))
+		.is_none());
