+#[cfg(unix)]
+#[tokio::test(flavor = "multi_thread", worker_threads = 2)]
+async fn readiness_status_credential_config_and_absent_owner_never_load_store() {
+	let root = tempfile::Builder::new()
+		.prefix("ready-secret-")
+		.tempdir_in("/tmp")
+		.unwrap();
+	let dir = root.path().join("fixture-secret-store");
+	let mut local = Process::start(settings(&dir, "http://user:fixture-secret@127.0.0.1:1")).await;
+	for request in [json!({"op":"status"}), json!({"op":"status","probe":true})] {
+		let report = local.request(request).await.unwrap();
+		assert!(!report.to_string().contains("fixture-secret"));
+		assert_ne!(report["state"], "ready");
+		assert!(!dir.exists());
+	}
+	local.stop().await;
+	let socket = root.path().join("fixture-secret-missing.sock");
+	let mut attached =
+		Process::start(json!({"dir":dir,"owner":{"endpoint":socket,"timeout_ms":100}})).await;
+	let status = attached
+		.request(json!({"op":"status","probe":true}))
+		.await
+		.unwrap();
+	assert_eq!(status["reason"], "absent");
+	assert_eq!(status["retryable"], true);
+	assert!(!status.to_string().contains("fixture-secret"));
+	assert!(!dir.exists());
+	assert!(!socket.exists());
+	attached.stop().await;
+}
