__pycache__/
.claude/
*.pyc
.DS_Store
.gstack/
.obsidian/


# third-party bundles, fetched by `pearde install --apply` and pinned there.
# The vault's own settings (data.json, the .json presets) stay tracked.
resources/board/obsidian/plugins/*/main.js
resources/board/obsidian/plugins/*/manifest.json
resources/board/obsidian/plugins/*/styles.css

# machine-local per board — regenerable. `pearde/` since 2026-09-02: a board
# with a dot in its name shows in no Obsidian vault (@references/obsidian.md),
# and `.pearde` is the compatibility symlink left where it was.
/pearde/
/.pearde

# one-off session measurements, kept beside the work they explain
/report.md
/report-*.md
/handover.md

/board

# machine-local, under a board nested anywhere below the root — regenerable.
# Both names: `pearde/` is the board since 2026-09-02, `.pearde/` the
# compatibility symlink and every board not yet upgraded.
pearde/.state/
pearde/wiki/
.pearde/.state/
.pearde/wiki/

# playwright-core for the js tests, fetched on demand — doctor prints the line
resources/board/node_modules/
resources/board/package.json
resources/board/package-lock.json
