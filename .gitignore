# The board's own branch. Everything here is the plan; what a tool can
# rebuild from it does not belong in the history.

.DS_Store

# live worker state — a claim is true only while the worker holds it
.claims/

# rebuilt by `pearde scan` and `pearde view`
.state/plan.json
.state/view.html
.state/parse-cache.json

# the round worker's handover to the dispatcher — read once, then answered
.state/ask.md

# machine-local, and the whole of it regenerable: this board's registration
# with the daemon, the daemon's rolling log when this board started it, an
# adapter run's output, the guard's per-session counters and the fitted
# weight→hours constant. They used to live in the install; the invariant
# `every-artifact-lands-inside-the-board` moved them here.
.state/serve.json
.state/serve.log
.state/run-*.log
.state/guard/
.state/calibration.json

# graphify's engine and its output — rebuilt by `pearde graph`
graphify/
wiki/graphs/
wiki/board/

# kept: .state/round.md, .state/history.jsonl, .state/transitions.jsonl —
# the board's own record of what happened, which nothing regenerates.

# machine-local, and two of them hold the same credential
wiki/.obsidian-api-key
wiki/.graphify/
wiki/Dashboard.report.md
.obsidian/
